rules_version = '2';

// Security model:
// - Anyone can READ a session and its queue (a teacher's board and a
//   student's ticket both need to see the live list without necessarily
//   having written to it).
// - Only a signed-in visitor (anonymous auth counts) may WRITE, and only
//   documents that match the shape the app actually creates. This keeps
//   out drive-by bots that find the URL but never load the app's JS,
//   without requiring students or teachers to ever see a login screen.
// - Queue entries are never updated — the app only ever creates or deletes
//   them, so update stays closed there.
// - A session document MAY be updated, but only to post/edit/clear its
//   `announcement` field (the teacher's on-screen note to students).
//   Everything else about a session (code, className, createdAt) is
//   immutable after creation.
// - Feedback notes are write-only from the app: anyone signed in
//   (anonymous auth counts) can submit one, but nothing can read, edit,
//   or delete them back through the client -- they're only visible to
//   whoever has direct Firestore/console access to the project, so one
//   student can't browse what other people wrote.
service cloud.firestore {
  match /databases/{database}/documents {

    match /feedback/{entryId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && isValidFeedback(request.resource.data);
    }

    match /sessions/{code} {
      allow read: if true;
      allow create: if request.auth != null && isValidSession(request.resource.data);
      allow update: if request.auth != null && (
          // Announcement-only updates (lastActiveAt may ride along as an
          // activity ping when a teacher reopens/resets the session)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['announcement', 'lastActiveAt'])
           && isValidAnnouncementUpdate(request.resource.data)
           && isValidActivityPing(request.resource.data))
          ||
          // Discussion control updates (discussionMode, questionsVisible, mutedUsers),
          // same lastActiveAt ride-along allowed
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['discussionMode', 'questionsVisible', 'mutedUsers', 'lastActiveAt'])
           && isValidDiscussionUpdate(request.resource.data)
           && isValidActivityPing(request.resource.data))
          ||
          // "Clear hands" marker so students can tell a bulk clear from being helped
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedAt'])
           && request.resource.data.clearedAt is number)
          ||
          // Per-session block list (uid -> label); dies with the session doc
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked'])
           && request.resource.data.blocked is map)
        );
      allow delete: if request.auth != null;

      match /queue/{entryId} {
        allow read: if true;
        // One hand per device per session: the ticket id must be the
        // creator's own uid, and update is closed so it can't be re-created
        // over. Blocked uids (see session.blocked) can't raise at all.
        allow create: if request.auth != null
          && request.auth.uid == entryId
          && isValidEntry(request.resource.data)
          && !(request.auth.uid in get(/databases/$(database)/documents/sessions/$(code)).data.get('blocked', {}));
        // A ticket can only be flagged helped / waiting (teacher's undo window).
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['waiting', 'helped'];
        allow delete: if request.auth != null;
      }

      match /questions/{questionId} {
        allow read: if true;
        allow create: if request.auth != null
          && isValidQuestion(request.resource.data)
          && request.resource.data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/sessions/$(code)).data.discussionMode == true
          && !(request.auth.uid in get(/databases/$(database)/documents/sessions/$(code)).data.get('blocked', {}));
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'skipped'];
        allow delete: if request.auth != null;
      }
    }

    function isValidSession(data) {
      // teacherKey is a short, private "reopen key" the app pairs with the
      // public 4-character join code so a student who only has the join
      // code can't claim someone else's teacher board. It's a casual
      // deterrent, not a secret -- this collection is publicly readable
      // (see the top-level comment), so anyone querying Firestore directly
      // could still read it. There are no accounts in this app, so that
      // tradeoff is accepted deliberately.
      // lastActiveAt tracks when a teacher last had this session open, so
      // a reused code can be soft-reset (queue/announcement/discussion
      // state cleared) on the next class period, or fully reclaimed if
      // it's sat untouched for months.
      return data.keys().hasOnly(['code', 'className', 'createdAt', 'teacherKey', 'lastActiveAt'])
        && data.code is string && data.code.size() <= 8
        && data.className is string && data.className.size() <= 60
        && data.createdAt is number
        && data.teacherKey is string && data.teacherKey.size() == 2
        && data.lastActiveAt is number;
    }

    function isValidActivityPing(data) {
      return !('lastActiveAt' in data) || data.lastActiveAt is number;
    }

    function isValidEntry(data) {
      // A queue entry needs a name, a seat number, or both -- and may
      // optionally carry a short private note the student chose to share.
      return data.keys().hasOnly(['name', 'seat', 'note', 'joinedAt', 'status', 'expireAt', 'kind'])
        && data.keys().hasAny(['name', 'seat'])
        && (!('kind' in data) || data.kind in ['question', 'stuck', 'check'])
        && (!('expireAt' in data) || data.expireAt is timestamp)
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 40))
        && (!('seat' in data) || (data.seat is string && data.seat.size() > 0 && data.seat.size() <= 12))
        && (!('note' in data) || (data.note is string && data.note.size() > 0 && data.note.size() <= 200))
        && data.joinedAt is number
        && data.status == 'waiting';
    }

    function isValidDiscussionUpdate(data) {
      return (!('discussionMode' in data) || data.discussionMode is bool)
        && (!('questionsVisible' in data) || data.questionsVisible is bool)
        && (!('mutedUsers' in data) || data.mutedUsers is map);
    }

    function isValidAnnouncementUpdate(data) {
      return data.announcement == null || isValidAnnouncement(data.announcement);
    }

    function isValidQuestion(data) {
      return data.keys().hasOnly(['text', 'authorId', 'authorName', 'authorSeat', 'status', 'createdAt', 'expireAt'])
        && (!('expireAt' in data) || data.expireAt is timestamp)
        && data.text is string && data.text.size() > 0 && data.text.size() <= 300
        && data.authorId is string
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 40))
        && (!('authorSeat' in data) || (data.authorSeat is string && data.authorSeat.size() <= 12))
        && data.status == 'active'
        && data.createdAt is number;
    }

    function isValidFeedback(data) {
      return data.keys().hasOnly(['text', 'role', 'createdAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && (!('role' in data) || data.role == null || data.role in ['teacher', 'student'])
        && data.createdAt is number;
    }

    function isValidAnnouncement(a) {
      return a.keys().hasOnly(['text', 'mode', 'id', 'postedAt', 'expiresAt'])
        && a.text is string && a.text.size() > 0 && a.text.size() <= 200
        && a.mode in ['timed', 'persistent', 'dismissable']
        && a.id is number
        && a.postedAt is number
        && (a.expiresAt == null || a.expiresAt is number);
    }
  }
}
