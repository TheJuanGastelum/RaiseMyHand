rules_version = '2';

// Security model:
// - Anyone can READ a session and its queue (a teacher's board and a
//   student's ticket both need to see the live list without necessarily
//   having written to it).
// - Only a signed-in visitor (anonymous auth counts) may WRITE, and only
//   documents that match the shape the app actually creates. This keeps
//   out drive-by bots that find the URL but never load the app's JS,
//   without requiring students or teachers to ever see a login screen.
// - Queue entries are never updated — the app only ever creates or deletes
//   them, so update stays closed there.
// - A session document MAY be updated, but only to post/edit/clear its
//   `announcement` field (the teacher's on-screen note to students).
//   Everything else about a session (code, className, createdAt) is
//   immutable after creation.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{code} {
      allow read: if true;
      allow create: if request.auth != null && isValidSession(request.resource.data);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['announcement'])
        && isValidAnnouncementUpdate(request.resource.data);
      allow delete: if request.auth != null;

      match /queue/{entryId} {
        allow read: if true;
        allow create: if request.auth != null && isValidEntry(request.resource.data);
        allow update: if false;
        allow delete: if request.auth != null;
      }
    }

    function isValidSession(data) {
      return data.keys().hasOnly(['code', 'className', 'createdAt'])
        && data.code is string && data.code.size() <= 8
        && data.className is string && data.className.size() <= 60
        && data.createdAt is number;
    }

    function isValidEntry(data) {
      // A queue entry needs a name, a seat number, or both -- and may
      // optionally carry a short private note the student chose to share.
      return data.keys().hasOnly(['name', 'seat', 'note', 'joinedAt', 'status'])
        && data.keys().hasAny(['name', 'seat'])
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 40))
        && (!('seat' in data) || (data.seat is string && data.seat.size() > 0 && data.seat.size() <= 12))
        && (!('note' in data) || (data.note is string && data.note.size() > 0 && data.note.size() <= 200))
        && data.joinedAt is number
        && data.status == 'waiting';
    }

    function isValidAnnouncementUpdate(data) {
      return data.announcement == null || isValidAnnouncement(data.announcement);
    }

    function isValidAnnouncement(a) {
      return a.keys().hasOnly(['text', 'mode', 'id', 'postedAt', 'expiresAt'])
        && a.text is string && a.text.size() > 0 && a.text.size() <= 200
        && a.mode in ['timed', 'persistent', 'dismissable']
        && a.id is number
        && a.postedAt is number
        && (a.expiresAt == null || a.expiresAt is number);
    }
  }
}
